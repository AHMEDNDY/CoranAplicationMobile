<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CoranWarshSynchroniser.Views.DuaDetailPage"
    BackgroundColor="#EAF1FB"
    FlowDirection="RightToLeft"
    Shell.NavBarIsVisible="False"
    ControlTemplate="{StaticResource QuranPageTemplate}">

    <Grid RowDefinitions="75,*">

        <Grid Grid.Row="0"
              BackgroundColor="#003B78">

            <Label Text="{Binding CategoryName}"
                   FontSize="25"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
        </Grid>

        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="18"
                Spacing="15">

                <Border BackgroundColor="White"
                        Stroke="#D9AB52"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 22"
                        Padding="20">

                    <VerticalStackLayout Spacing="15">

                        <Label Text="{Binding CategoryName}"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="#003B78"
                               HorizontalOptions="Center"/>

                        <BoxView
                            BackgroundColor="#D9AB52"
                            HeightRequest="1"
                            WidthRequest="130"
                            HorizontalOptions="Center"/>

                        <Label
                            Text="اختر الدعاء لقراءته والاستماع إليه"
                            FontSize="20"
                            TextColor="#102B52"
                            HorizontalTextAlignment="Center"/>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>