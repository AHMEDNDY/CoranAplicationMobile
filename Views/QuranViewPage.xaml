<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CoranWarshSynchroniser.Views.QuranViewPage"
             xmlns:local="clr-namespace:CoranWarshSynchroniser.ViewModels"
             BackgroundColor="#FFFCE7">

    <CarouselView x:Name="QuranCarousel"
                  ItemsSource="{Binding Pages}"
                  IndicatorView="indicator"
                  IsSwipeEnabled="True"
                  FlowDirection="RightToLeft"
                  HorizontalScrollBarVisibility="Never"
                  VerticalScrollBarVisibility="Never">

        <CarouselView.ItemTemplate>
            <DataTemplate>
                <ScrollView>
                    <VerticalStackLayout Padding="12">

                        <!-- Header -->
                        <HorizontalStackLayout HorizontalOptions="Fill"
                                              >
                            <Button Text="←"
                                    Clicked="OnBackClicked"/>

                            <Frame BackgroundColor="#FFCC88"
                                   CornerRadius="12"
                                   Padding="4">
                                <Label Text="{Binding PageLabel}"
                                       FontFamily="aldahabi"
                                       FontSize="12"/>
                            </Frame>

                            <Button Text="⚙"/>
                        </HorizontalStackLayout>

                        <!-- Spacer for first pages -->
                        <Grid HeightRequest="{Binding TopSpacing}"/>

                        <!-- Quran Text -->
                        <local:QuranRichTextView
                            PageNumber="{Binding PageNumber}"
                            JsonData="{Binding JsonData}"
                            HighlightVerse="{Binding HighlightVerse}"
                            ShouldHighlight="{Binding ShouldHighlight}"/>
                    </VerticalStackLayout>
                </ScrollView>
            </DataTemplate>
        </CarouselView.ItemTemplate>
    </CarouselView>

    <!--<IndicatorView x:Name="indicator"/>-->
</ContentPage>
