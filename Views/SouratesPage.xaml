<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CoranWarshSynchroniser.Converters"
             xmlns:viewmodel="clr-namespace:CoranWarshSynchroniser.ViewModels"
             x:Class="CoranWarshSynchroniser.Views.SouratesPage"
             FlowDirection="RightToLeft"
             BackgroundColor="#F7F7F7"
             Title="SouratesPageffff">

    <ContentPage.Resources>
        <ResourceDictionary>
            <local:IconConverter x:Key="IconConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <CollectionView 
        ItemsSource="{Binding FilteredSourates}"
        SelectionMode="None">

        <!--SearchBar en header-->
        <CollectionView.Header>
            <SearchBar Placeholder="ابحث عن السورة"
                       FontSize="16"
                       FlowDirection="RightToLeft"
                       TextColor="#1E1E1E"
                       PlaceholderColor="#7A5A2E"
                       BackgroundColor="White"
                       SearchCommand="{Binding SearchCommand}"
                       SearchCommandParameter="{Binding Text, Source={x:Reference SearchBarRef}}"
                       x:Name="SearchBarRef"
                       Margin="10,10,10,0"/>
        </CollectionView.Header>

        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame CornerRadius="20"
                       Padding="12"
                       Margin="0,6"
                       BorderColor="#7A5A2E"
                       HasShadow="False"
                       BackgroundColor="White">

                    <Grid ColumnDefinitions="40,*,70"
                          VerticalOptions="Center">

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer 
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:SouratesViewModel}}, Path=SelectSourateCommand}"
                                CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>

                        <!--Icône-->
                        <Image Grid.Column="2"
                               HeightRequest="40"
                               WidthRequest="40"
                               Source="{Binding IsMecca, Converter={StaticResource IconConverter}}" />

                        <!--Texte-->
                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="4">
                            <Label Text="{Binding Name}"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   FontFamily="UthmanicWarsh"
                                   TextColor="#1E1E1E" />

                            <Label Text="{Binding TotalVerses, StringFormat='عدد آياتها {0}'}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   FontFamily="UthmanicWarsh"
                                   TextColor="#7A5A2E" />
                        </VerticalStackLayout>

                        <!--Numéro-->
                        <Frame Grid.Column="0"
                               HeightRequest="40"
                               WidthRequest="40"
                               CornerRadius="20"
                               Padding="0"
                               BackgroundColor="#099ffc"
                               HorizontalOptions="Center"
                               VerticalOptions="Center">

                            <Label Text="{Binding Id}"
                                   TextColor="Black"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Frame>

                    </Grid>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>