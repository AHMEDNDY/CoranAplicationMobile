<?xml version="1.0" encoding="utf-8" ?>
<controls:AnimatedContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CoranWarshSynchroniser.Views"
    xmlns:vm="clr-namespace:CoranWarshSynchroniser.ViewModels"
    xmlns:local="clr-namespace:CoranWarshSynchroniser.Converters"
    x:Class="CoranWarshSynchroniser.Views.SouratesPage"
    x:Name="SouratesRoot"
    ControlTemplate="{StaticResource QuranPageTemplate}"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    FlowDirection="RightToLeft"
    BackgroundColor="#EDF3FC">

    <!-- La barre inférieure est ajoutée automatiquement par QuranPageTemplate. -->
    <ContentPage.BindingContext>
        <vm:SouratesViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <ResourceDictionary>
            <local:IconConverter x:Key="IconConverter" />
            <local:ArabicVerseNumberConverter x:Key="ArabicVerseNumberConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- Seul le contenu supérieur est ici : aucun second footer. -->
    <Grid RowDefinitions="112,100,74,*"
          RowSpacing="0"
          BackgroundColor="#EDF3FC">

        <!-- 1. En-tête bleu nuit avec motifs géométriques -->
        <Grid Grid.Row="0">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#002763" Offset="0" />
                    <GradientStop Color="#0752AD" Offset="0.48" />
                    <GradientStop Color="#002454" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>

            <Image Source="pattern_islamic.png"
                   Aspect="AspectFill"
                   Opacity="0.12"
                   InputTransparent="True" />

            <Grid Padding="17,9,17,12"
                  ColumnDefinitions="45,*,45"
                  FlowDirection="LeftToRight">
                <Label Grid.Column="0"
                       Text="❮"
                       FontSize="26"
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </Label.GestureRecognizers>
                </Label>

                <Label Grid.Column="1"
                       Text="قائمة السور"
                       FontSize="29"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"
                       FlowDirection="RightToLeft" />
            </Grid>

            <BoxView HeightRequest="3"
                     Color="#E5AE42"
                     VerticalOptions="End" />
        </Grid>

        <!-- 2. Quatre filtres : Tous / Mecque / Médine / Favoris -->
        <Grid Grid.Row="1"
              Padding="12,7,12,4"
              ColumnDefinitions="*,*,*,*"
              ColumnSpacing="7"
              FlowDirection="RightToLeft"
              BackgroundColor="#DDE9FA">

            <!-- الكل -->
            <Border Grid.Column="0"
                    BackgroundColor="{Binding AllButtonColor}"
                    Stroke="{Binding AllBorderColor}"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 18"
                    Padding="4">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AllCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="0"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <Label Text="۞"
                           FontSize="27"
                           TextColor="{Binding AllTextColor}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="الكل"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{Binding AllTextColor}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- مكية -->
            <Border Grid.Column="1"
                    BackgroundColor="{Binding MeccaButtonColor}"
                    Stroke="{Binding MeccaBorderColor}"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 18"
                    Padding="4">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding MeccaCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="3"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <Image Source="mecca.png"
                           WidthRequest="27"
                           HeightRequest="27"
                           Aspect="AspectFit" />
                    <Label Text="مكية"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{Binding MeccaTextColor}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- مدنية -->
            <Border Grid.Column="2"
                    BackgroundColor="{Binding MedinaButtonColor}"
                    Stroke="{Binding MedinaBorderColor}"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 18"
                    Padding="4">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding MedinaCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="3"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <Image Source="medina.png"
                           WidthRequest="27"
                           HeightRequest="27"
                           Aspect="AspectFit" />
                    <Label Text="مدنية"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{Binding MedinaTextColor}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- المفضلة -->
            <Border Grid.Column="3"
                    BackgroundColor="{Binding FavoritesButtonColor}"
                    Stroke="{Binding FavoritesBorderColor}"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 18"
                    Padding="4">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding FavoritesCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="0"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <Label Text="★"
                           FontSize="27"
                           TextColor="#E3A326"
                           HorizontalTextAlignment="Center" />
                    <Label Text="المفضلة"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="{Binding FavoritesTextColor}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- 3. Recherche dans les 114 sourates -->
        <Grid Grid.Row="2" Padding="14,7,14,7" BackgroundColor="#EDF3FC">
            <Border BackgroundColor="#FFFFFF"
                    Stroke="#CFDDF5"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 24">
                <Border.Shadow>
                    <Shadow Brush="#223D6E" Offset="0,2" Radius="7" Opacity="0.12" />
                </Border.Shadow>
                <Grid ColumnDefinitions="38,*"
                      Padding="13,0,10,0"
                      FlowDirection="RightToLeft">
                    <Label Grid.Column="0"
                           Text="⌕"
                           FontSize="33"
                           TextColor="#093B86"
                           VerticalTextAlignment="Center"
                           HorizontalTextAlignment="Center" />
                    <Entry Grid.Column="1"
                           Text="{Binding SearchText}"
                           Placeholder="بحث عن سورة ..."
                           PlaceholderColor="#65789A"
                           TextColor="#0A2860"
                           BackgroundColor="Transparent"
                           FontSize="17"
                           FlowDirection="RightToLeft"
                           HorizontalTextAlignment="Start"
                           ClearButtonVisibility="WhileEditing"
                           VerticalOptions="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- 4. Liste déroulante : le footer reste fixe en dehors de ce Grid. -->
        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding DisplaySurahs}"
                        SelectionMode="None"
                        Margin="12,0,12,0"
                        VerticalOptions="FillAndExpand">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="4" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:SourateDisplayItem">
                    <Grid Padding="2,5,2,5">
                        <Border BackgroundColor="White"
                                Stroke="#D6E3F6"
                                StrokeThickness="1.2"
                                StrokeShape="RoundRectangle 22"
                                HeightRequest="94">
                            <Border.Shadow>
                                <Shadow Brush="#253857" Offset="0,3" Radius="7" Opacity="0.13" />
                            </Border.Shadow>

                            <Grid FlowDirection="RightToLeft"
                                  ColumnDefinitions="48,*,38,38"
                                  ColumnSpacing="8"
                                  Padding="11,10,11,10">

                                <!-- Zone sélection : numéro, sourate, origine -->
                                <Grid Grid.Column="0"
                                      Grid.ColumnSpan="3"
                                      FlowDirection="RightToLeft"
                                      ColumnDefinitions="48,*,38"
                                      ColumnSpacing="8">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SouratesViewModel}}, Path=SurahTappedCommand}"
                                            CommandParameter="{Binding Sourate}" />
                                    </Grid.GestureRecognizers>

                                    <!-- Numéro doré -->
  
                                    <Grid Grid.Column="0" WidthRequest="43" HeightRequest="43"
       VerticalOptions="Center" HorizontalOptions="Center">
                                        <Image Source="reader_ayah_badge.png" Aspect="AspectFit" />
                                        <Label Text="{Binding Id}"
            TextColor="#0B2450" FontSize="20"
            FontAttributes="Bold" VerticalTextAlignment="Center"
            HorizontalTextAlignment="Center" />
                                    </Grid>
                                    <!--<Border Grid.Column="0"
                                            WidthRequest="43" HeightRequest="43"
        VerticalOptions="Center" HorizontalOptions="Center">

                                        <Label Text="{Binding Id,Converter={StaticResource ArabicVerseNumberConverter}}"
                                                TextColor="#0B2450" FontSize="20"
                                                     FontAttributes="Bold" VerticalTextAlignment="Center"
                                                     HorizontalTextAlignment="Center" />
                                    </Border>-->

                                    <!-- Nom arabe, translittération, versets -->
                                    <Grid Grid.Column="1"
                                          RowDefinitions="Auto,Auto"
                                          RowSpacing="4"
                                          VerticalOptions="Start">
                                        <Label Grid.Row="0"
                                               Text="{Binding DisplayName}"
                                               FontFamily="UthmanicWarsh"
                                               FontSize="22"
                                               FontAttributes="Bold"
                                               TextColor="#0A1A43"
                                               HorizontalTextAlignment="Start"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1" />

                                        <Grid Grid.Row="1"
                                              FlowDirection="LeftToRight"
                                              ColumnDefinitions="*,Auto"
                                              ColumnSpacing="5">
                                            <Label Grid.Column="0"
                                                   Text="{Binding LatinName}"
                                                   FontSize="12"
                                                   TextColor="#25334E"
                                                   HorizontalTextAlignment="End"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding VerseLabel}"
                                                   FontSize="12"
                                                   TextColor="#25334E"
                                                   HorizontalTextAlignment="End" />
                                        </Grid>
                                    </Grid>

                                    <!-- Icône Mecque / Médine : converter existant -->
                                    <Image Grid.Column="2"
                                           Source="{Binding IsMecca, Converter={StaticResource IconConverter}}"
                                           WidthRequest="31"
                                           HeightRequest="31"
                                           Aspect="AspectFit"
                                           VerticalOptions="Center"
                                           HorizontalOptions="Center" />
                                </Grid>

                                <!-- Étoile interactive, distincte du tap de navigation -->
                                <Label Grid.Column="3"
                                       Text="{Binding FavoriteSymbol}"
                                       TextColor="{Binding FavoriteColor}"
                                       FontSize="28"
                                       VerticalTextAlignment="Center"
                                       HorizontalTextAlignment="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SouratesViewModel}}, Path=ToggleFavoriteCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="20,65" Spacing="12"
                                     HorizontalOptions="Center">
                    <Label Text="⌕" FontSize="44" TextColor="#A3B8D9"
                           HorizontalTextAlignment="Center" />
                    <Label Text="لا توجد سورة مطابقة للبحث"
                           FontSize="17" TextColor="#587094"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</controls:AnimatedContentPage>
