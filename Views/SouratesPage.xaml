<?xml version="1.0" encoding="utf-8" ?>
<controls:AnimatedContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CoranWarshSynchroniser.ViewModels"
             xmlns:local="clr-namespace:CoranWarshSynchroniser.Converters"
             xmlns:models="clr-namespace:CoranWarshSynchroniser.Models"
              xmlns:controls="clr-namespace:CoranWarshSynchroniser.Views"
             x:Class="CoranWarshSynchroniser.Views.SouratesPage"
             Shell.NavBarIsVisible="False"
             FlowDirection="RightToLeft"
             >
    <ContentPage.BindingContext>
        <vm:SouratesViewModel />
    </ContentPage.BindingContext>
    <ContentPage.Resources>
        <ResourceDictionary>
            <local:IconConverter x:Key="IconConverter" />
            <local:MeccaTextConverter x:Key="MeccaTextConverter" />
        </ResourceDictionary>
      
    </ContentPage.Resources>
    
    <Grid RowDefinitions="Auto,*">

        <!-- ══════════════ HEADER ══════════════ -->
        <Grid Grid.Row="0"
              RowDefinitions="Auto,Auto,Auto"
              Padding="0,0,0,24">
            <VerticalStackLayout Grid.Row="0"
                     WidthRequest="350"
                     HorizontalOptions="Center"
                     VerticalOptions="Start"
                     Margin="0,4,0,0"
                     Spacing="4">

                <Image Source="sorateimagetransparent.png"
           HeightRequest="180"
           WidthRequest="180"
           HorizontalOptions="Center"
           Aspect="AspectFit"/>
                <Label Text="رواية ورش عن نافع"
           FontSize="18"
           FontAttributes="Bold"
           HorizontalOptions="Center"/>
            </VerticalStackLayout>
            
            <!-- Barre de recherche -->
            <Border Grid.Row="1"
                    Margin="20,18,20,0"
                    StrokeThickness="0"
                    BackgroundColor="#1C3FD0"
                    StrokeShape="RoundRectangle 120">
                <Grid ColumnDefinitions="*,Auto" Padding="16,0">
                    <Entry Grid.Column="0"
                           Placeholder="🔍  ابحث عن سورة"
                           PlaceholderColor="White"
                           TextColor="White"
                           BackgroundColor="Transparent"
                           Text="{Binding SearchText}"
                           FontSize="20"
                           HeightRequest="48"
                           VerticalOptions="Center"/>
                  
                </Grid>
            </Border>

            <!-- Compteur de résultats -->
            <Grid Grid.Row="2"
      Margin="20,10,20,0"
      ColumnDefinitions="Auto,*,Auto"
      VerticalOptions="Center">

                <!-- Bouton gauche -->
                <Button Grid.Column="0"
        Text="مدنية"
        ImageSource="medina.png"
        Command="{Binding MedinaCommand}"
        BackgroundColor="{Binding MedinaButtonColor}"
        FontSize="18"
        FontAttributes="Bold" 
        TextColor="White"
        CornerRadius="8"
        WidthRequest="100"
        HeightRequest="34"/>

                <Button Grid.Column="1"
        Text="مكية"
        ImageSource="mecca.png"
        Command="{Binding MeccaCommand}"
         BackgroundColor="{Binding MeccaButtonColor}"
        FontSize="20"
        FontAttributes="Bold"                
        TextColor="White"
        CornerRadius="8"
        WidthRequest="100"
        HeightRequest="34"
        HorizontalOptions="Center"/>
          

                <!-- Nombre de sourates -->
                <Label Grid.Column="2"
           VerticalOptions="Center"
           FontSize="12"
           >

                    <Label.FormattedText>
                        <FormattedString>      
                            <Span Text="{Binding Surahs.Count}"
                      FontAttributes="Bold"
                                  FontSize="20"
                      TextColor="Black"/>
                            <Span Text=" سورة" FontSize="20"  FontAttributes="Bold" TextColor="Black"/>
                      
                         
                        </FormattedString>
                    </Label.FormattedText>

                </Label>

            </Grid>
       
        </Grid>

        <!-- ══════════════ LISTE ══════════════ -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Surahs}"
                        Margin="0,4,0,0"
                        SelectionMode="None">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="0"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Sourate">
                    <Grid Padding="16,6">

                        <!-- Carte -->
                        <Border BackgroundColor="White"
                                StrokeThickness="1.5"
                                Stroke="#EDE9FE"
                                StrokeShape="RoundRectangle 16"
                                Padding="0">
                            <Border.Shadow>
                                <Shadow Brush="#5A3CA0"
                                        Offset="0,3"
                                        Radius="8"
                                        Opacity="0.08"/>
                            </Border.Shadow>

                            <Grid ColumnDefinitions="4,64,*,Auto"
                                  Padding="0,14,16,14">

                                <!-- Barre accent gauche -->
                                <BoxView Grid.Column="0"
                                         CornerRadius="4,0,0,4">
                                    <BoxView.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="{Binding NumberBackgroundColor}" Offset="0"/>
                                            <GradientStop Color="{Binding NumberBackgroundColor}" Offset="1"/>
                                        </LinearGradientBrush>
                                    </BoxView.Background>
                                </BoxView>

                                <!-- Badge numéro -->
                                <Border Grid.Column="1"
                                        Margin="10,0"
                                        BackgroundColor="#F5F3FF"
                                        Stroke="#7C3AED"
                                        StrokeThickness="2"
                                        StrokeShape="RoundRectangle 10"
                                        WidthRequest="46"
                                        HeightRequest="46"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding Id}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="#5B21B6"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>

                                <!-- Nom + badges -->
                                <VerticalStackLayout Grid.Column="2"
                                                     VerticalOptions="Center"
                                                     Spacing="5">
                                    <Label Text="{Binding Name}"
                                           FontSize="24"
                                           FontAttributes="Bold"
                                           FontFamily="UthmanicWarsh"
                                           TextColor="#1E1033"/>
                                    <HorizontalStackLayout Spacing="6">
                                        <!-- Badge Makkah / Madinah -->

                                        <Label Text="•"
                                               TextColor="#9CA3AF"
                                               FontSize="4"
                                               VerticalOptions="Center"/>
                                        <!-- Nombre de versets -->
                                        <Label FontSize="12"
                                               TextColor="#6B7280"
                                               VerticalOptions="Center">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding IsMecca, Converter={StaticResource MeccaTextConverter}}"
                                                          BackgroundColor="#F4F0FF"
                                                          TextColor="#7C4DFF"/>
                                                    <Span Text=" عدد آياتها "/>
                                                    <Span Text="{Binding TotalVerses}"/>

                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>


                                <Image Grid.Column="3"
                               HeightRequest="40"
                               WidthRequest="40"
                               Source="{Binding IsMecca, Converter={StaticResource IconConverter}}" />
                            </Grid>
                        </Border>

                        <!-- Geste tap sur la carte -->
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SouratesViewModel}},
                                                  Path=SurahTappedCommand}"
                                CommandParameter="{Binding .}"/>
                        </Grid.GestureRecognizers>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- Vue vide -->
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Padding="0,60"
                                     Spacing="12">
                    <Label Text="🔍" FontSize="40" HorizontalOptions="Center"/>
                    <Label Text="Aucune sourate trouvée"
                           FontSize="16"
                           TextColor="#9CA3AF"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>
        <!-- ✅ Barre de navigation flottante : span sur toute la hauteur -->
        <controls:CustomBottomNav Grid.Row="0"
                               Grid.RowSpan="2"
                               VerticalOptions="End"/>
    </Grid>
    </controls:AnimatedContentPage>