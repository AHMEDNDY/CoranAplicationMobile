<?xml version="1.0" encoding="utf-8" ?>

<controls:AnimatedContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CoranWarshSynchroniser.ViewModels"
    xmlns:local="clr-namespace:CoranWarshSynchroniser.Converters"
    xmlns:models="clr-namespace:CoranWarshSynchroniser.Models"
    xmlns:controls="clr-namespace:CoranWarshSynchroniser.Views"
    x:Class="CoranWarshSynchroniser.Views.SouratesPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="White"
    FlowDirection="RightToLeft">

    <!-- VIEWMODEL -->
    <ContentPage.BindingContext>
        <vm:SouratesViewModel />
    </ContentPage.BindingContext>

    <!-- RESOURCES -->
    <ContentPage.Resources>
        <ResourceDictionary>
            <local:IconConverter
                x:Key="IconConverter" />

            <local:MeccaTextConverter
                x:Key="MeccaTextConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- =========================== -->
        <!-- HEADER -->
        <!-- =========================== -->

        <Grid Grid.Row="0"
              RowDefinitions="Auto,Auto,Auto"
              RowSpacing="0"
              Padding="20,5,20,0">

            <!-- LOGO + TITRE -->
            <Grid Grid.Row="0"
                  FlowDirection="LeftToRight"
                  ColumnDefinitions="*,125"
                  HeightRequest="110">

                <Label Grid.Column="0"
                       Text="رواية ورش عن نافع"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#111111"
                       HorizontalOptions="Center"
                       VerticalOptions="Start"
                       Margin="70,22,0,0"
                       FlowDirection="RightToLeft"/>

                <Image Grid.Column="1"
                       Source="sorateimagetransparent.png"
                       HeightRequest="110"
                       WidthRequest="120"
                       Aspect="AspectFit"
                       HorizontalOptions="End"
                       VerticalOptions="Start"/>

            </Grid>

            <!-- BARRE DE RECHERCHE -->
            <Border Grid.Row="1"
                    Margin="20,18,20,0"
                    HeightRequest="50"
                    BackgroundColor="#2144D8"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 30">

                <Grid ColumnDefinitions="Auto,*"
                      FlowDirection="RightToLeft"
                      Padding="15,0"
                      ColumnSpacing="6">

                    <Label Grid.Column="0"
                           Text="🔍"
                           FontSize="23"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"/>

                    <Entry Grid.Column="1"
                           Text="{Binding SearchText}"
                           Placeholder="ابحث عن سورة"
                           PlaceholderColor="White"
                           TextColor="White"
                           BackgroundColor="Transparent"
                           FontSize="18"
                           FlowDirection="RightToLeft"
                           HorizontalTextAlignment="Start"
                           VerticalOptions="Center"
                           ClearButtonVisibility="WhileEditing"/>

                </Grid>

            </Border>

            <!-- FILTRES -->
            <Grid Grid.Row="2"
                  Margin="10,35,10,0"
                  FlowDirection="LeftToRight"
                  ColumnDefinitions="Auto,*,*"
                  ColumnSpacing="15"
                  HeightRequest="47">

                <!-- NOMBRE SOURATES -->
                <Label Grid.Column="0"
                       VerticalOptions="Center"
                       FlowDirection="RightToLeft">

                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding Surahs.Count}"
                                  FontSize="20"
                                  FontAttributes="Bold"
                                  TextColor="#111111"/>

                            <Span Text=" سورة"
                                  FontSize="18"
                                  FontAttributes="Bold"
                                  TextColor="#111111"/>
                        </FormattedString>
                    </Label.FormattedText>

                </Label>

                <!-- BOUTON MECQUE -->
                <Border Grid.Column="1"
                        HeightRequest="44"
                        BackgroundColor="{Binding MeccaButtonColor}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 9"
                        HorizontalOptions="Center"
                        WidthRequest="105">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding MeccaCommand}"/>
                    </Border.GestureRecognizers>

                    <HorizontalStackLayout
                        FlowDirection="RightToLeft"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="7">

                        <Image Source="mecca.png"
                               WidthRequest="27"
                               HeightRequest="27"
                               Aspect="AspectFit"/>

                        <Label Text="مكية"
                               FontSize="19"
                               FontAttributes="Bold"
                               TextColor="White"
                               VerticalOptions="Center"/>

                    </HorizontalStackLayout>

                </Border>

                <!-- BOUTON MEDINE -->
                <Border Grid.Column="2"
                        HeightRequest="44"
                        WidthRequest="105"
                        BackgroundColor="{Binding MedinaButtonColor}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 9"
                        HorizontalOptions="Center">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding MedinaCommand}"/>
                    </Border.GestureRecognizers>

                    <HorizontalStackLayout
                        FlowDirection="RightToLeft"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="7">

                        <Image Source="medina.png"
                               WidthRequest="27"
                               HeightRequest="27"
                               Aspect="AspectFit"/>

                        <Label Text="مدنية"
                               FontSize="19"
                               FontAttributes="Bold"
                               TextColor="White"
                               VerticalOptions="Center"/>

                    </HorizontalStackLayout>

                </Border>

            </Grid>

        </Grid>

        <!-- =========================== -->
        <!-- LISTE DES SOURATES -->
        <!-- =========================== -->

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Surahs}"
            SelectionMode="None"
            Margin="0,50,0,0">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout
                    Orientation="Vertical"
                    ItemSpacing="3"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>

                <DataTemplate x:DataType="models:Sourate">

                    <Grid Padding="15,5,15,5">

                        <!-- CARTE -->
                        <Border
                            BackgroundColor="White"
                            Stroke="#EAE5FF"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 17"
                            HeightRequest="96">

                            <Border.Shadow>
                                <Shadow
                                    Brush="#6750A4"
                                    Offset="0,4"
                                    Radius="5"
                                    Opacity="0.10"/>
                            </Border.Shadow>

                            <Grid
                                FlowDirection="RightToLeft"
                                ColumnDefinitions="4,55,*,52"
                                ColumnSpacing="5"
                                Padding="0,8,12,8">

                                <!-- BARRE VERTICALE -->
                                <BoxView
                                    Grid.Column="0"
                                    BackgroundColor="{Binding NumberBackgroundColor}"
                                    WidthRequest="4"
                                    VerticalOptions="Fill"
                                    CornerRadius="3"/>

                                <!-- NUMERO SOURATE -->
                                <Border
                                    Grid.Column="1"
                                    BackgroundColor="#F5F2FF"
                                    Stroke="#8244FF"
                                    StrokeThickness="2"
                                    StrokeShape="RoundRectangle 11"
                                    WidthRequest="46"
                                    HeightRequest="46"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="{Binding Id}"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        TextColor="#6129D8"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"/>

                                </Border>

                                <!-- NOM ET DESCRIPTION -->
                                <VerticalStackLayout
                                    Grid.Column="2"
                                    VerticalOptions="Center"
                                    HorizontalOptions="Fill"
                                    Spacing="6">

                                    <!-- NOM -->
                                    <Label
                                        Text="{Binding Name}"
                                        FontFamily="UthmanicWarsh"
                                        FontSize="24"
                                        FontAttributes="Bold"
                                        TextColor="#20152F"
                                        HorizontalTextAlignment="Start"
                                        FlowDirection="RightToLeft"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="1"/>

                                    <!-- TYPE + VERSETS -->
                                    <Label
                                        FontSize="12"
                                        TextColor="#7B8291"
                                        HorizontalTextAlignment="Start"
                                        FlowDirection="RightToLeft">

                                        <Label.FormattedText>
                                            <FormattedString>

                                                <Span
                                                    Text="{Binding IsMecca, Converter={StaticResource MeccaTextConverter}}"
                                                    TextColor="#9961FF"
                                                    TextDecorations="Underline"/>

                                                <Span Text="  عدد آياتها "/>

                                                <Span Text="{Binding TotalVerses}"/>

                                            </FormattedString>
                                        </Label.FormattedText>

                                    </Label>

                                </VerticalStackLayout>

                                <!-- ICON MECCA / MEDINA -->
                                <Image
                                    Grid.Column="3"
                                    Source="{Binding IsMecca, Converter={StaticResource IconConverter}}"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    Aspect="AspectFit"
                                    VerticalOptions="Center"
                                    HorizontalOptions="Center"/>

                            </Grid>

                        </Border>

                        <!-- CLIC SUR LA SOURATE -->
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SouratesViewModel}}, Path=SurahTappedCommand}"
                                CommandParameter="{Binding .}"/>
                        </Grid.GestureRecognizers>

                    </Grid>

                </DataTemplate>

            </CollectionView.ItemTemplate>

            <!-- AUCUN RESULTAT -->
            <CollectionView.EmptyView>

                <VerticalStackLayout
                    Padding="20,60"
                    Spacing="12"
                    HorizontalOptions="Center">

                    <Label
                        Text="🔍"
                        FontSize="40"
                        HorizontalOptions="Center"/>

                    <Label
                        Text="لا توجد سورة مطابقة للبحث"
                        FontSize="16"
                        TextColor="#9CA3AF"
                        HorizontalOptions="Center"/>

                </VerticalStackLayout>

            </CollectionView.EmptyView>

            <!-- ESPACE POUR MENU BAS -->
            <CollectionView.Footer>
                <BoxView
                    HeightRequest="85"
                    Opacity="0"/>
            </CollectionView.Footer>

        </CollectionView>

        <!-- NAVIGATION BASSE -->
        <controls:CustomBottomNav
            Grid.Row="0"
            Grid.RowSpan="2"
            VerticalOptions="End"
            HorizontalOptions="Fill"/>

    </Grid>

</controls:AnimatedContentPage>
