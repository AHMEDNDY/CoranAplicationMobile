<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="CoranWarshSynchroniser.Views.CustomBottomNav"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    HeightRequest="108"
    BackgroundColor="Transparent">

    <Grid HeightRequest="108" IsClippedToBounds="False">

        <!-- Bord supérieur ondulé inspiré du footer de la maquette -->
        <Path Aspect="Fill"
              Fill="#073075"
              Stroke="#DDB153"
              StrokeThickness="2.5"
              StrokeLineJoin="Round"
              Data="M 0,130 L 0,40 C 110,28 250,25 344,43 C 407,58 448,13 500,0 C 552,13 593,58 656,43 C 750,25 890,28 1000,40 L 1000,130 Z" />

        <Grid ColumnDefinitions="*,*,*,*,*"
              FlowDirection="RightToLeft"
              ColumnSpacing="0"
              Padding="8,0,8,3">

            <!-- القرآن (à droite) -->
            <Border x:Name="TabQuran" Grid.Column="0"
                    BackgroundColor="Transparent" StrokeThickness="0"
                    Margin="0,27,0,0" Padding="0,5">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnQuranTapped" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="3"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <Image x:Name="IconQuran" Source="ui_footer_quran_white.png"
                           WidthRequest="28" HeightRequest="28" />
                    <Label x:Name="TextQuran" Text="القرآن"
                           TextColor="White" FontSize="11"
                           FontAttributes="Bold" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- الأدعية -->
            <Border x:Name="TabDua" Grid.Column="1"
                    BackgroundColor="Transparent" StrokeThickness="0"
                    Margin="0,27,0,0" Padding="0,5">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDuaTapped" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="3"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <Image x:Name="IconDua"
                           Source="ui_footer_dua_white.png"
                           WidthRequest="28"
                           HeightRequest="28"
                           Aspect="AspectFit"
                           HorizontalOptions="Center" />
                    <Label x:Name="TextDua" Text="الأدعية"
                       TextColor="White" FontSize="11"
                       FontAttributes="Bold" HorizontalTextAlignment="Center" />    
                </VerticalStackLayout>
            </Border>

            <!-- الرئيسية : onglet central surélevé -->
            <Border x:Name="TabHome" Grid.Column="2"
                    HeightRequest="104"
                    VerticalOptions="End"
                    BackgroundColor="#0B398B"
                    Stroke="#DFB354"
                    StrokeThickness="2.2"
                    Padding="4,9,4,7">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="27,27,19,19" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHomeTapped" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="4"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <Image x:Name="IconHome" Source="ui_footer_home_gold.png"
                           WidthRequest="32" HeightRequest="32" />
                    <Label x:Name="TextHome" Text="الرئيسية"
                           TextColor="#FFDC76" FontSize="12"
                           FontAttributes="Bold" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- المفضلة -->
            <Border x:Name="TabFavorites" Grid.Column="3"
                    BackgroundColor="Transparent" StrokeThickness="0"
                    Margin="0,27,0,0" Padding="0,5">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFavoritesTapped" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="3"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <Image x:Name="IconFavorites" Source="ui_footer_bookmark_white.png"
                           WidthRequest="27" HeightRequest="27" />
                    <Label x:Name="TextFavorites" Text="المفضلة"
                           TextColor="White" FontSize="11"
                           FontAttributes="Bold" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- الإعدادات (à gauche) -->
            <Border x:Name="TabSettings" Grid.Column="4"
                    BackgroundColor="Transparent" StrokeThickness="0"
                    Margin="0,27,0,0" Padding="0,5">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSettingsTapped" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="3"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <Image x:Name="IconSettings" Source="ui_footer_settings_white.png"
                           WidthRequest="27" HeightRequest="27" />
                    <Label x:Name="TextSettings" Text="الإعدادات"
                           TextColor="White" FontSize="11"
                           FontAttributes="Bold" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentView>
