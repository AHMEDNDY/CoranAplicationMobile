<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- 🎨 Couleurs Mushaf -->

    <Color x:Key="MushafBackground">#E7F1CF</Color>

    <Color x:Key="MushafHighlight">#D6E2C2</Color>

    <Color x:Key="MushafBorder">#6B8E23</Color>

    <Color x:Key="AyahCircleBackground">#DFF0C2</Color>

    <Color x:Key="AyahCircleBorder">#7FA65A</Color>

    <Color x:Key="AyahTextColor">#000000</Color>

    <Color x:Key="SeparatorColor">#B7C59A</Color>


    <!-- 📖 Page Mushaf -->

    <Style TargetType="ContentPage" x:Key="MushafPageStyle">
        <Setter Property="BackgroundColor" Value="{StaticResource MushafBackground}" />
    </Style>


    <!-- 📖 Texte Ayah -->

    <Style TargetType="Label" x:Key="AyahLabelStyle">

        <Setter Property="FontSize" Value="28"/>

        <Setter Property="TextColor"
                Value="{StaticResource AyahTextColor}"/>

        <Setter Property="LineBreakMode"
                Value="WordWrap"/>

        <Setter Property="HorizontalTextAlignment"
                Value="End"/>

    </Style>


    <!-- 🔢 Cercle numéro Ayah -->

    <Style TargetType="Frame" x:Key="AyahCircleStyle">

        <Setter Property="BackgroundColor"
                Value="{StaticResource AyahCircleBackground}" />

        <Setter Property="BorderColor"
                Value="{StaticResource AyahCircleBorder}" />

        <Setter Property="CornerRadius" Value="50"/>

        <Setter Property="HeightRequest" Value="30"/>

        <Setter Property="WidthRequest" Value="30"/>

        <Setter Property="Padding" Value="0"/>

        <Setter Property="HasShadow" Value="False"/>

    </Style>


    <!-- Ligne séparatrice -->

    <Style TargetType="BoxView" x:Key="SeparatorStyle">

        <Setter Property="HeightRequest" Value="1"/>

        <Setter Property="Color"
                Value="{StaticResource SeparatorColor}"/>

        <Setter Property="Margin" Value="0,10"/>

    </Style>

</ResourceDictionary>