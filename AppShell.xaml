<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CoranWarshSynchroniser.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CoranWarshSynchroniser.Views"
    Title="Liste Sourates"
>
    <Shell.Resources>
        <ResourceDictionary>
            <!-- Couleur des titres de la TabBar -->
            <Style TargetType="ShellContent">
                <Setter Property="Shell.TabBarTitleColor" Value="White"/>
                <Setter Property="Shell.TabBarUnselectedColor" Value="red"/>
                <Setter Property="Shell.TabBarBackgroundColor" Value="#099ffc"/>
            </Style>
        </ResourceDictionary>
    </Shell.Resources>

    <TabBar>
        <ShellContent
            Title="القرآن"
            Icon="quranapp.png"
            ContentTemplate="{DataTemplate local:SouratesPage}"
            Route="SouratesPage"/>
        <ShellContent
            Title="الفئات"
            Icon="category.png"
            ContentTemplate="{DataTemplate local:QuranPage}"
            Route="CategoryPage"/>
        <ShellContent
            Title="المساهمين"
            Icon="tasbih.png"
            ContentTemplate="{DataTemplate local:QuranReaderPage}"
            Route="QuranReaderPage"/>
    </TabBar>


</Shell>
